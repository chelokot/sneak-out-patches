{
  "name": "@chelokot/sneak-out-patches",
  "version": "0.6.7",
  "description": "Sneak Out reverse-engineering, patching, and runtime mod tooling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelokot/sneak-out-patches.git"
  },
  "type": "module",
  "bin": {
    "sneakout-patches": "cli/sneakout-patches.mjs"
  },
  "files": [
    "cli/",
    "artifacts/runtime_mods/",
    "config_templates/runtime_mods/",
    "runtime_mods_manifest.json",
    "supported_game_build.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tooling:install": "node scripts/install.mjs",
    "doctor": "node scripts/doctor.mjs",
    "patcher": "node scripts/run-python.mjs tools/patch_sneak_out.py",
    "runtime:session": "node scripts/runtime-session.mjs",
    "runtime:session:host": "node scripts/runtime-session.mjs --host-launch",
    "performance:session": "node scripts/performance-session.mjs",
    "performance:analyze": "node scripts/analyze-performance-session.mjs",
    "runtime:profiler:configure": "node scripts/configure-runtime-profiler.mjs",
    "runtime:profiler:off": "node scripts/configure-runtime-profiler.mjs off",
    "interop:inspect": "node scripts/run-dotnet.mjs run --project tools/interop_inspector/InteropInspector.csproj --",
    "mod:list": "node scripts/build-runtime-mod.mjs --list",
    "mod:build": "node scripts/build-runtime-mod.mjs",
    "mods:build": "node scripts/build-runtime-mod.mjs --all",
    "installer:payload": "node scripts/package-installer-payload.mjs",
    "installer:test": "node --test tests/installer/install-uninstall.test.mjs",
    "voice:test": "node scripts/run-dotnet.mjs run --project tools/proximity_voice_tests/ProximityVoiceTests.csproj --",
    "gameplay-fixes:test": "node scripts/run-dotnet.mjs run --project tools/gameplay_fixes_tests/GameplayFixesTests.csproj --",
    "check": "npm run mods:build && npm run voice:test && npm run gameplay-fixes:test && npm run installer:test"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
